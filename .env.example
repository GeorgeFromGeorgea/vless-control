# The «Получить ключ» action assigns KEY_PROFILE_ID (one active profile) and creates an individual UUID. Existing config is reconciled on XRAY_MANAGED_VLESS_PORT (default 443); a missing inbound tag gets `vless-control-<port>` without changing protocol behavior. Do not use a generated bootstrap config for a live existing server: retain its full config and clients. Sync remains dry-run unless --apply is explicitly supplied.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
DATABASE_PATH=data/vless-control.sqlite3
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_BINARY=/usr/local/bin/xray
XRAY_SERVICE=xray
# Existing VLESS inbound to manage; defaults to the ordinary VLESS/TCP inbound on 443.
XRAY_MANAGED_VLESS_PORT=443
# ID of the single preconfigured profile automatically assigned by «Получить ключ».
KEY_PROFILE_ID=
