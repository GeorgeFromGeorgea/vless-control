# Создаётся установщиком только на чистом Ubuntu/Debian. Секреты не публикуйте.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
PUBLIC_SERVER_HOST=
DATABASE_PATH=/var/lib/vless-control/bot.db
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json
XRAY_BINARY=/usr/local/bin/xray
XRAY_SERVICE=xray
XRAY_MANAGED_VLESS_PORT=443
# Должен совпадать с tag единственного управляемого VLESS/TCP security=none inbound.
XRAY_MANAGED_PROFILE_TAG=vless-control-managed
KEY_PROFILE_ID=
